# -----------------------------------------------------------------------------
# 3D Digital Armory & Sci-Fi Archive Environment Variables Configuration
# Copy this file to .env at the root of the project before running.
# -----------------------------------------------------------------------------

# =============================================================================
# Django Backend Settings
# =============================================================================

# Django Settings Module (development / production)
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret Key for cryptographic signing (Generate a secure random string for production)
SECRET_KEY=django-insecure-3d-armory-production-secret-key-fantasy-sci-fi-2025

# Debug mode (True for local development, False for production)
DEBUG=True

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated list of allowed CORS origins for React frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Settings (Defaults to SQLite; configure PostgreSQL for production)
POSTGRES_DB=armory_db
POSTGRES_USER=armory_user
POSTGRES_PASSWORD=armory_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =============================================================================
# React / Vite Frontend Settings
# =============================================================================

# API base URL for REST endpoints (leave blank if relying on Vite proxy)
VITE_API_URL=http://localhost:8000
